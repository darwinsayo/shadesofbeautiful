<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} | {{ site.short }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{% if title and page.url != '/' %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
{% if cover %}<meta property="og:image" content="{{ cover }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<script>document.documentElement.classList.add('js')</script>
</head>
<body>

<header>
  <nav class="topbar" aria-label="Main">
    <a href="/">Home</a>
    <a href="/#weddings">Photos</a>
    <a href="/journal/">Journal</a>
    <a href="/#hello">Say hello</a>
  </nav>
  <div class="brand">
    <p class="tag">Photographs and notes<br>by Darwin Sayo</p>
    <a class="mark" href="/">{{ site.short }}</a>
  </div>
</header>

<main id="top">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <a class="mark small" href="/">{{ site.short }}</a>
    <a class="foot-link" href="/gear/">Gear</a>
    <span>&copy; 2026 {{ site.name }}</span>
  </div>
</footer>

<script>
  // Gentle fade-in for photos as they scroll into view. Without script, everything is simply visible.
  (function () {
    var root = document.documentElement;
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.remove('js'); return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.1 });
    document.querySelectorAll('.plate, .card, .reveal').forEach(function (el) { io.observe(el); });
  })();
</script>

{% if site.cloudflareAnalyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
{% endif %}
</body>
</html>
