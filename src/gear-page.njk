---
layout: base.njk
headerClass: solid
title: Gear
description: The cameras and gear I use.
permalink: /gear/
eleventyExcludeFromCollections: true
---
<div class="wrap page-head gear-head">
  <h1>{{ gearpage.title }}</h1>
  <p>{{ gearpage.intro }}</p>
</div>

{% set cats = ["Cameras", "Lenses", "Accessories", "Software"] %}
<section class="gear-list">
  <div class="wrap gear-layout">
    <nav class="gear-nav" aria-label="Gear sections">
      <span class="gear-nav-label">Jump to</span>
      {% for cat in cats %}
        {% set items = collections.gear | byCategory(cat) %}
        {% if items.length %}<a href="#{{ cat | lower }}">{{ cat }}</a>{% endif %}
      {% endfor %}
    </nav>
    <div class="gear-main">
    {% for cat in cats %}
      {% set items = collections.gear | byCategory(cat) %}
      {% if items.length %}
      <div class="gear-cat reveal" id="{{ cat | lower }}">
        <h2>{{ cat }}</h2>
        {% for g in items %}
        <article class="gear-item">
          <div class="gear-top">
            <h3>{{ g.data.title }}</h3>
            {% if g.data.status %}<span class="gear-tag">{{ g.data.status }}</span>{% endif %}
          </div>
          {% if g.data.tagline %}<p class="gear-line">{{ g.data.tagline }}</p>{% endif %}
          {% if g.templateContent | trim %}<div class="gear-note">{{ g.templateContent | safe }}</div>{% endif %}
          {% if g.data.why %}
          <div class="gear-why">
            <h4>Why I use it</h4>
            <ul>{% for w in g.data.why %}<li>{{ w }}</li>{% endfor %}</ul>
          </div>
          {% endif %}
        </article>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</section>
